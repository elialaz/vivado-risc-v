// VexiiRiscv SoC instance for SpinalBoardWrapper (see that file for the
// signals). VexiiSoc comes from vexiiriscv.soc.litex.SocGen.
  VexiiSoc soc (
    .litex_clk                           (clock),
    .litex_reset                         (soc_reset),
    .debugReset                          (reset_sync[2]),
    .debug_dm_ndmreset                   (ndmreset),
    .debug_tap_jtag_tms                  (jtag_tms),
    .debug_tap_jtag_tck                  (jtag_tck),
    .debug_tap_jtag_tdi                  (jtag_tdi),
    .debug_tap_jtag_tdo                  (jtag_tdo),
    .peripheral_externalInterrupts_port  ({23'd0, irq_sync, 1'b0}),
    .debug                               (),

    .pBus_awvalid (p_awvalid), .pBus_awready (p_awready), .pBus_awaddr (p_awaddr), .pBus_awprot (),
    .pBus_wvalid  (p_wvalid),  .pBus_wready  (p_wready),  .pBus_wdata  (p_wdata),  .pBus_wstrb (p_wstrb),
    .pBus_bvalid  (p_bvalid),  .pBus_bready  (p_bready),  .pBus_bresp  (p_bresp),
    .pBus_arvalid (p_arvalid), .pBus_arready (p_arready), .pBus_araddr (p_araddr), .pBus_arprot (),
    .pBus_rvalid  (p_rvalid),  .pBus_rready  (p_rready),  .pBus_rdata  (p_rdata),  .pBus_rresp (p_rresp),

    .mBus_awvalid (mem_axi4_awvalid), .mBus_awready (mem_axi4_awready), .mBus_awaddr (m_awaddr),
    .mBus_awid    (mem_axi4_awid),    .mBus_awlen   (mem_axi4_awlen),   .mBus_awsize (mem_axi4_awsize),
    .mBus_awburst (mem_axi4_awburst), .mBus_awallStrb (),
    .mBus_wvalid  (mem_axi4_wvalid),  .mBus_wready  (mem_axi4_wready),  .mBus_wdata  (mem_axi4_wdata),
    .mBus_wstrb   (mem_axi4_wstrb),   .mBus_wlast   (mem_axi4_wlast),
    .mBus_bvalid  (mem_axi4_bvalid),  .mBus_bready  (mem_axi4_bready),  .mBus_bid    (mem_axi4_bid),
    .mBus_bresp   (mem_axi4_bresp),
    .mBus_arvalid (mem_axi4_arvalid), .mBus_arready (mem_axi4_arready), .mBus_araddr (m_araddr),
    .mBus_arid    (mem_axi4_arid),    .mBus_arlen   (mem_axi4_arlen),   .mBus_arsize (mem_axi4_arsize),
    .mBus_arburst (mem_axi4_arburst),
    .mBus_rvalid  (mem_axi4_rvalid),  .mBus_rready  (mem_axi4_rready),  .mBus_rdata  (mem_axi4_rdata),
    .mBus_rid     (mem_axi4_rid),     .mBus_rresp   (mem_axi4_rresp),   .mBus_rlast  (mem_axi4_rlast),

    .dma_bus_awvalid (d_awvalid), .dma_bus_awready (d_awready), .dma_bus_awid (4'd0),
    .dma_bus_awaddr  (dma_axi4_awaddr[31:0]), .dma_bus_awlen (dma_axi4_awlen),
    .dma_bus_awsize  (dma_axi4_awsize), .dma_bus_awburst (dma_axi4_awburst),
    .dma_bus_awlock  (dma_axi4_awlock), .dma_bus_awcache (dma_axi4_awcache),
    .dma_bus_awprot  (dma_axi4_awprot), .dma_bus_awqos (dma_axi4_awqos),
    .dma_bus_awregion (4'd0),
    .dma_bus_wvalid  (dma_axi4_wvalid), .dma_bus_wready (dma_axi4_wready),
    .dma_bus_wdata   (dma_axi4_wdata),  .dma_bus_wstrb (dma_axi4_wstrb), .dma_bus_wlast (dma_axi4_wlast),
    .dma_bus_bvalid  (d_bvalid), .dma_bus_bready (dma_axi4_bready), .dma_bus_bid (d_bid),
    .dma_bus_bresp   (dma_axi4_bresp),
    .dma_bus_arvalid (d_arvalid), .dma_bus_arready (d_arready), .dma_bus_arid (4'd0),
    .dma_bus_araddr  (dma_axi4_araddr[31:0]), .dma_bus_arlen (dma_axi4_arlen),
    .dma_bus_arsize  (dma_axi4_arsize), .dma_bus_arburst (dma_axi4_arburst),
    .dma_bus_arlock  (dma_axi4_arlock), .dma_bus_arcache (dma_axi4_arcache),
    .dma_bus_arprot  (dma_axi4_arprot), .dma_bus_arqos (dma_axi4_arqos),
    .dma_bus_arregion (4'd0),
    .dma_bus_rvalid  (d_rvalid), .dma_bus_rready (dma_axi4_rready), .dma_bus_rid (d_rid),
    .dma_bus_rdata   (dma_axi4_rdata), .dma_bus_rresp (dma_axi4_rresp), .dma_bus_rlast (dma_axi4_rlast)
  );
